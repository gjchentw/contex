# Copy to .env so that `docker compose run --rm compile-latex` writes build
# artifacts owned by you instead of by root:
#
#   printf 'CONTEX_UID=%s\nCONTEX_GID=%s\n' "$(id -u)" "$(id -g)" > .env
#
# The scripts in scripts/ export these themselves, so they work without .env.
CONTEX_UID=1000
CONTEX_GID=1000
